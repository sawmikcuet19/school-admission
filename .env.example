# Database (used by docker compose and can be reused for local development)
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# How long a held seat stays reserved before it is released automatically.
HOLD_DURATION_SECONDS=60

# Initial school-admin verification password. It is hashed and stored in the
# database on first startup; change it from the Admin tab afterwards. The value
# is ignored once a password has already been stored.
ADMIN_PASSWORD=ChangeMe-Admin1

# Base URL the browser uses to reach the backend. The Vite dev server in
# Docker reads this at startup; restart the frontend after changing it.
VITE_API_BASE_URL=http://localhost:8080
